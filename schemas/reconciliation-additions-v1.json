{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "devrec/reconciliation-additions@1"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "additions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "fragment-v1.json"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "schema",
    "request_digest",
    "additions",
    "contradictions",
    "source_artifact_ids"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devrec/reconciliation-additions@1"
}
