{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "devrec/reconciliation-additions@1"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "additions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": 1
          },
          "id": {
            "type": "string",
            "default": "",
            "description": "Empty only before CLI ID allocation; persisted records require a valid ID."
          },
          "name": {
            "type": "string",
            "default": ""
          },
          "kind": {
            "enum": [
              "changelog",
              "adr",
              "docs",
              "performance"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295,
            "default": 1
          },
          "revises": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,128}$"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "retired": {
            "type": "boolean",
            "default": false
          },
          "supersedes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,128}$"
            },
            "uniqueItems": true,
            "default": []
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,128}$"
            },
            "uniqueItems": true,
            "default": []
          },
          "conflicts_with": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,128}$"
            },
            "uniqueItems": true,
            "default": []
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {}
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_-]{1,128}$"
                },
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "after": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_-]{1,128}$"
                  },
                  "uniqueItems": true,
                  "default": []
                }
              },
              "required": [
                "id",
                "title",
                "body"
              ]
            },
            "default": []
          },
          "accepted": {
            "type": "boolean",
            "default": false
          },
          "performance": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "policy"
                  },
                  "source_inventory_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "source_inventory_digest",
                  "rationale"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "const": "measurement"
                  },
                  "source_inventory_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "evidence": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string"
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      },
                      "command": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "result_digest": {
                        "type": "string",
                        "pattern": "^sha256:[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "digest",
                      "command",
                      "result_digest"
                    ]
                  }
                },
                "required": [
                  "type",
                  "source_inventory_digest",
                  "evidence"
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "provenance": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "task_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "request_digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "task_id",
                  "revision_id",
                  "result_digest",
                  "request_digest"
                ]
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "required": [
          "schema_version",
          "kind",
          "title",
          "body"
        ],
        "title": "Development record input v1",
        "description": "Strict serde wire contract with local scalar constraints. Graph relationships, non-whitespace content, kind-specific fields, safe relative paths, revisions, and evidence authority are additionally checked by Rust."
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "schema",
    "request_digest",
    "additions",
    "contradictions",
    "source_artifact_ids"
  ]
}
